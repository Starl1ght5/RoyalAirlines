# Mismos nombres que usa el backend de Spring
DB_URI=mongodb://localhost:27017
DB_DATABASE=royal_airlines

# Clave para /internal/** en Spring y para /recalcular y /recomendaciones de esta API
# (obligatoria: vacía = la API de Python responde 503, igual que el backend)
INTERNAL_API_KEY=cambia-esta-clave

# Opcionales
RECS_COLLECTION=UserRecommendations
PREFS_COLLECTION=UserPreferences

# Tasa COP->USD del backend (MoneyExchange.COP_EXCHANGE_RATE); UserPreferences.budgetMax
# está en COP y el puntaje trabaja en USD
COP_USD_RATE=4000

# Si se define, las listas se envían a POST /internal/recommendations/bulk con X-API-Key
# (Spring escribe) en vez de escribir MongoDB directamente. Vacío = escritura directa.
SPRING_INTERNAL_URL=
