<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permiso de red obligatorio TAMBIÉN en release (debug/profile ya
         lo incluyen aparte). Sin él, el APK compilado con
         `flutter build apk` no podría hablar con el backend. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13+ (API 33): sin este permiso en el manifest el sistema ni
         siquiera ofrece el dialogo para aceptar notificaciones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Royal Airlines"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Canal por defecto de las notificaciones FCM. Debe coincidir con el
             id que crea MainActivity y con el que envia el backend
             (PushService.ANDROID_CHANNEL = "offers"). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="offers" />
        <!-- Icono de la barra de estado. Provisional: Android pinta los iconos
             de notificacion en una sola tinta, asi que con el icono de color
             del launcher se ve como un cuadro blanco. Mas adelante conviene
             un drawable monocromo propio. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
