# Copia este archivo a ".env" (que esta en .gitignore) y rellena los valores.
# En un servicio de hosting define estas mismas variables en su panel, no subas el .env.

# --- MongoDB (obligatorio) ---
DB_URI=mongodb://localhost:27017
DB_DATABASE=royal_airlines

# --- Google OAuth (obligatorio) ---
# Client ID / secret de la consola de Google Cloud.
GOOGLE_OAUTH_CLIENT=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=tu-client-secret

# --- JWT (obligatorio) ---
# Clave en Base64 de al menos 32 bytes. Generar una con:
#   openssl rand -base64 48
JWT_SECRET=

# --- Integracion con el microservicio de recomendaciones (opcional) ---
# Misma clave que usa el servicio Python en su .env. Vacia = /internal/** responde 503.
INTERNAL_API_KEY=
# URL base del servicio Python, p. ej. http://localhost:8001. Vacia = recalculo en caliente deshabilitado.
RECOMMENDER_URL=

# --- Notificaciones push con Firebase (opcional) ---
PUSH_ENABLED=false
# Ruta al JSON de la cuenta de servicio. En Windows usa "/" (p. ej. C:/secrets/firebase.json).
FIREBASE_CREDENTIALS_PATH=

# --- Frontend / CORS (opcional) ---
# Origenes permitidos separados por coma (solo hace falta para clientes web; la app movil no usa CORS).
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://royalairlines.netlify.app
FRONTEND_OAUTH_SUCCESS_URL=https://royalairlines.netlify.app/oauth-success
FRONTEND_OAUTH_FAILURE_URL=https://royalairlines.netlify.app/login?error=google

# --- Servidor (opcional) ---
# Muchos hostings inyectan PORT automaticamente.
PORT=8080
